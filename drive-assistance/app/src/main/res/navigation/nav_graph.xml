<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/selectFragment">

    <fragment
        android:id="@+id/selectFragment"
        android:name="com.samsung.driveassistance.fragments.SelectFragment"
        android:label="Select"
        tools:layout="@layout/fragment_select">

        <action
            android:id="@+id/action_selectFragment_to_imageFragment"
            app:destination="@id/imageFragment" />

        <action
            android:id="@+id/action_selectFragment_to_cameraFragment"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/imageFragment"
        android:name="com.samsung.driveassistance.fragments.ImageFragment"
        android:label="Image"
        tools:layout="@layout/fragment_image">

        <action
            android:id="@+id/action_imageFragment_to_selectFragment"
            app:destination="@id/selectFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.samsung.driveassistance.fragments.CameraFragment"
        android:label="Camera">

        <action
            android:id="@+id/action_cameraFragment_to_selectFragment"
            app:destination="@id/selectFragment" />
    </fragment>

</navigation>